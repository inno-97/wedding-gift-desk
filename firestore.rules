rules_version = '2';

// 접근 모델: 장부 UUID(URL)를 아는 사람만 읽고 쓸 수 있다.
// - 장부 목록 조회(list) 금지 → UUID를 모르면 아무것도 볼 수 없음
// - 실제 삭제(delete) 금지 → 삭제는 deleted=true 표시(소프트 삭제)만
// - 봉투번호 = 문서 ID → 번호 중복 불가
service cloud.firestore {
  match /databases/{database}/documents {

    function isUuid(id) {
      return id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }

    function optStr(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }

    function validLedger(d) {
      return d.keys().hasOnly(['title', 'ticketsInitial', 'defaultTickets', 'defaultAmount', 'createdAt', 'updatedAt'])
        && (!('defaultAmount' in d) || d.defaultAmount == null || (d.defaultAmount is int && d.defaultAmount >= 0 && d.defaultAmount <= 100000000))
        && (!('defaultTickets' in d) || (d.defaultTickets is int && d.defaultTickets >= 0 && d.defaultTickets <= 20))
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 40
        && (d.ticketsInitial == null || (d.ticketsInitial is int && d.ticketsInitial >= 0 && d.ticketsInitial <= 10000))
        && d.createdAt is timestamp;
    }

    match /ledgers/{lid} {
      allow get: if isUuid(lid);
      allow list: if false;
      allow create: if isUuid(lid) && validLedger(request.resource.data);
      allow update: if validLedger(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      function validEntry(eid, d) {
        return d.keys().hasOnly(['no', 'name', 'relation', 'tickets', 'amount', 'memo',
                                 'deleted', 'movedTo', 'createdAt', 'updatedAt'])
          && d.no is int && d.no >= 1 && d.no <= 99999
          && eid == string(d.no)
          && d.tickets is int && d.tickets >= 0 && d.tickets <= 100
          && (d.amount == null || (d.amount is int && d.amount >= 0 && d.amount <= 100000000))
          && d.name is string && d.name.trim().size() >= 1 && d.name.size() <= 60
          && optStr(d, 'relation', 60) && optStr(d, 'memo', 300)
          && d.deleted is bool
          && d.createdAt is timestamp;
      }

      match /entries/{eid} {
        allow read: if isUuid(lid) && exists(/databases/$(database)/documents/ledgers/$(lid));
        allow create: if exists(/databases/$(database)/documents/ledgers/$(lid))
          && validEntry(eid, request.resource.data);
        // 기존 봉투 덮어쓰기 방지: 신규 등록은 createdAt을 새로 찍으므로,
        // 이미 살아있는 번호에 신규 등록이 들어오면 createdAt 불일치로 거부된다.
        // 단, 삭제 처리된 번호는 재사용(덮어쓰기) 허용.
        allow update: if validEntry(eid, request.resource.data)
          && (request.resource.data.createdAt == resource.data.createdAt
              || resource.data.deleted == true);
        allow delete: if false;
      }
    }
  }
}
